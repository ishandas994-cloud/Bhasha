# Copy this file to .env (or set these in your hosting dashboard).
# .env is gitignored - never commit real secrets.

# Base URL of the deployed BanglaLang backend, NO trailing slash.
# Required in production builds; leave unset for local dev
# (Vite proxies /api/* to http://localhost:8081 during dev).
VITE_API_URL=https://bangla-lang-backend.onrender.com
