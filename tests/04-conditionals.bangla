# পরীক্ষা ০৪: conditionals - যদি / নাহলে
ধরি নম্বর = ৭৫;

যদি (নম্বর >= ৮০) {
    লিখ "A+";
} নাহলে {
    লিখ "A";
}

যদি (নম্বর == ৭৫) {
    লিখ "সত্যই";
}

যদি (নম্বর != ৭৫) {
    লিখ "ভুল";
} নাহলে {
    লিখ "ঠিক";
}

# else-if chain via nesting
যদি (নম্বর >= ৯০) {
    লিখ "গ্রেড: A+";
} নাহলে {
    যদি (নম্বর >= ৬০) {
        লিখ "গ্রেড: B";
    } নাহলে {
        লিখ "গ্রেড: F";
    }
}
