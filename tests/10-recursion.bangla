# পরীক্ষা ১০: recursion - ফ্যাক্টরিয়াল and ফিবোনাচি

ফাংশন ফ্যাক্টরিয়াল(n) {
    যদি (n <= ১) {
        ফেরত ১;
    }
    ফেরত n * ফ্যাক্টরিয়াল(n - ১);
}

ফাংশন ফিবোনাচি(n) {
    যদি (n <= ২) {
        ফেরত ১;
    }
    ফেরত ফিবোনাচি(n - ১) + ফিবোনাচি(n - ২);
}

লিখ ফ্যাক্টরিয়াল(৫);
লিখ ফিবোনাচি(১০);
