# পরীক্ষা ০৯: functions - ফাংশন, parameters, return values

ফাংশন যোগ(a, b) {
    ফেরত a + b;
}

ফাংশন বড়(x, y) {
    যদি (x > y) {
        ফেরত x;
    }
    ফেরত y;
}

ফাংশন তিন_যোগ(a, b, c) {
    ফেরত a + b + c;
}

ফাংশন শুভেচ্ছা(নাম) {
    ফেরত "স্বাগতম, " + নাম + "!";
}

লিখ যোগ(১০, ৩২);
লিখ বড়(৯৯, ৭);
লিখ তিন_যোগ(১০০, ২০, ৩);
লিখ শুভেচ্ছা("রাহুল");

# a function calling another function
ফাংশন দ্বিগুণ(a) {
    ফেরত a * ২;
}
লিখ দ্বিগুণ(যোগ(৩, ২));
